# Backend secrets stay here, never in VITE_ variables. Copy to .env; do not commit it.
DATA_MODE=fixture

# AI-01: one OpenRouter key for the backend. Leave empty to use keyword rules only.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
# Optional per-task overrides: LLM_MODEL_INTERPRET, LLM_MODEL_EXPLAIN
LLM_TIMEOUT_S=12
# deny (default) | allow. Free OpenRouter models need allow: the provider may train on the query text.
LLM_DATA_COLLECTION=deny
# Output budget; reasoning models need headroom.
LLM_MAX_TOKENS=2500

# BE-01: "cache" serves committed OSRM responses first (use for the pitch).
ROUTING_SOURCE=live

# DATA-04: dane.um.warszawa.pl key for the import scripts only.
DANE_WWA_API_KEY=

# MCP-01: bearer token for the HTTP MCP server (required; generate with
# python -c 'import secrets;print(secrets.token_urlsafe(32))'). Optional extra Host names:
MCP_TOKEN=
# MCP_ALLOWED_HOSTS=silver-storm.wirehair-altair.ts.net:8001

# Container stack (compose.yaml). BIND_ADDR is the only address ports are published on; on a server
# use its Tailscale address (`tailscale ip -4`). Never 0.0.0.0 or a public address.
# BIND_ADDR=127.0.0.1
# MCP_ALLOWED_HOSTS=silver-storm.wirehair-altair.ts.net:8001
